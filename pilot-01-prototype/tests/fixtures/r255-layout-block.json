"\n/* Narrow dual-platform support: read each venue without half-width columns. */\n@media (max-width: 480px) {\n  .v3-compare-page .v3-versus-card--supporting:not([style]) {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .v3-compare-page .v3-versus-card--supporting:not([style]) > .v3-versus-side {\n    display: flex;\n    grid-row: auto;\n    padding-inline: 0.72rem;\n    border-inline-end: none;\n  }\n\n  .v3-compare-page .v3-versus-card--supporting:not([style]) > .v3-versus-side + .v3-versus-side {\n    border-block-start: 1px solid var(--reader-material-rule, #29323e);\n    padding-block-start: 0.85rem;\n  }\n}\n"