+  };
+  Object.defineProperty(doc, 'visibilityState', { configurable: true, get: () => clock.documentRef.visibilityState });
+  const add = doc.addEventListener.bind(doc), remove = doc.removeEventListener.bind(doc);
+  doc.addEventListener = (type, fn, options) => {
+    if (type === 'visibilitychange') visibilityListeners.add(fn);
+    add(type, fn, options);
+  };
+  doc.removeEventListener = (type, fn, options) => {
+    if (type === 'visibilitychange') visibilityListeners.delete(fn);
+    remove(type, fn, options);
+  };
+  class Observer {
+    constructor(callback) { this.callback = callback; this.targets = new Set(); observers.push(this); }
+    observe(target) { this.targets.add(target); }
+    disconnect() { this.disconnected = true; this.targets.clear(); }
+    emit(visible) { this.callback([...this.targets].map(target => ({ target, isIntersecting: visible }))); }
+  }
+  dom.window.matchMedia = () => ({ matches: false });
+  install('window', dom.window);
+  install('document', doc);
+  install('IntersectionObserver', Observer);
+  install('setTimeout', clock.setTimer);
+  install('clearTimeout', clock.clearTimer);
+  install('IS_REACT_ACT_ENVIRONMENT', true);
+  Date.now = clock.now;
+  t.after(async () => {
+    if (root) await act(async () => { root.unmount(); });
+    Date.now = originalNow;
+    for (const [name, descriptor] of saved) {
+      if (descriptor) Object.defineProperty(globalThis, name, descriptor); else delete globalThis[name];
+    }
+    dom.window.close();
+  });
+
+  // FundingBoard's callback-ref/enable contract, with the production clock hook.
+  // Starting without a section reproduces the previously missed hydration seed.
+  function FundingClock({ available }) {
+    const [target, setTarget] = useState(null);
+    const now = useClientNow(Boolean(target), null, target);
+    renders++;
+    return available ? React.createElement('section', { id: 'funding', ref: setTarget, 'data-now': now ?? '' }) : null;
+  }
+  const render = async available => act(async () => { root.render(React.createElement(FundingClock, { available })); });
+  const advance = async ms => act(async () => { await clock.advance(ms); });
+  const visibility = async state => act(async () => {
+    clock.visibility(state);
+    doc.dispatchEvent(new dom.window.Event('visibilitychange'));
+  });
+  root = createRoot(doc.getElementById('root'));
+  await render(false);
+  assert.equal(doc.getElementById('funding'), null);
+  assert.equal(clock.timers.size, 0, 'absent funding creates no second clock');
+  assert.equal(observers.length, 0);
+  const absentRenders = renders;
+  await advance(5000);
+  assert.equal(renders, absentRenders);
+
+  await render(true);
+  assert.equal(observers.length, 1, 'late callback ref attaches an observer');
+  assert.ok(observers[0].targets.has(doc.getElementById('funding')));
+  await act(async () => { observers[0].emit(false); });
+  const offscreenRenders = renders, offscreenCallbacks = clock.callbacks();
+  await advance(5000);
+  assert.equal(clock.timers.size, 0);
+  assert.equal(clock.callbacks(), offscreenCallbacks);
+  assert.equal(renders, offscreenRenders, 'late offscreen funding does not re-render each second');
+
+  await act(async () => { observers[0].emit(true); });
+  assert.equal(clock.timers.size, 1, 'one clock starts when the section becomes visible');
+  assert.equal(Number(doc.getElementById('funding').dataset.now), clock.now());
+  const visibleCallbacks = clock.callbacks();
+  await advance(5000);
+  assert.equal(clock.callbacks() - visibleCallbacks, 5, 'one callback per second while visible');
+  assert.equal(Number(doc.getElementById('funding').dataset.now), clock.now());
+  assert.equal(clock.timers.size, 1);
+
+  await visibility('hidden');
+  assert.equal(clock.timers.size, 0, 'hidden tab removes its clock');
+  const hiddenRenders = renders, hiddenCallbacks = clock.callbacks();
+  await advance(5000);
+  assert.equal(renders, hiddenRenders);
+  assert.equal(clock.callbacks(), hiddenCallbacks);
+  await visibility('visible');
+  assert.equal(clock.timers.size, 1);
+  assert.equal(Number(doc.getElementById('funding').dataset.now), clock.now(), 'return immediately catches up the countdown');
+
+  await act(async () => { observers[0].emit(false); });
+  const stoppedRenders = renders;
+  await advance(5000);
+  assert.equal(clock.timers.size, 0);
+  assert.equal(renders, stoppedRenders);
+  await render(false);
+  assert.ok(observers[0].disconnected);
+  assert.equal(visibilityListeners.size, 0);
+  await render(true);
+  assert.equal(observers.length, 2, 'replacement section gets its own observer');
+  await act(async () => { observers[1].emit(true); });
+  assert.equal(clock.timers.size, 1);
+  await act(async () => { root.unmount(); });
+  root = null;
+  assert.ok(observers[1].disconnected);
+  assert.equal(clock.timers.size, 0);
+  assert.equal(visibilityListeners.size, 0, 'unmount removes hook and scheduler listeners');
+});
diff --git a/pilot-01-prototype/tests/home-globe-idle.test.mjs b/pilot-01-prototype/tests/home-globe-idle.test.mjs
new file mode 100644
index 00000000..c40bc149
--- /dev/null
+++ b/pilot-01-prototype/tests/home-globe-idle.test.mjs
@@ -0,0 +1,170 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+const { mountGlobe } = await import(process.env.GLOBE_TEST_MODULE || '../src/components/v7/home7-globe.js');
+
+// Drive actual mount/draw/lifecycle code with a deterministic browser clock. No
+// wall-clock sleeps or browser CPU measurements: callbacks and canvas paints are
+// the work this module is allowed to schedule while the page is idle.
+function browser(t, { still = false } = {}) {
+  const saved = new Map();
+  let now = 0, serial = 0, paints = 0, reads = 0, frameCalls = 0, globe;
+  const frames = new Map(), observers = [], resizeObservers = [];
+  const target = () => {
+    const handlers = new Map();
+    return {
+      addEventListener(type, fn) { if (!handlers.has(type)) handlers.set(type, new Set()); handlers.get(type).add(fn); },
+      removeEventListener(type, fn) { handlers.get(type)?.delete(fn); },
+      emit(type, event = {}) { for (const fn of handlers.get(type) || []) fn(event); },
+      get listenerCount() { return [...handlers.values()].reduce((n, fns) => n + fns.size, 0); },
+    };
+  };
+  const context = new Proxy({}, {
+    get(obj, key) {
+      if (key === 'clearRect') return () => { paints += 1; };
+      if (key === 'createRadialGradient') return () => ({ addColorStop() {} });
+      return obj[key] || (() => {});
+    },
+    set(obj, key, value) { obj[key] = value; return true; },
+  });
+  const canvases = [];
+  const doc = Object.assign(target(), {
+    hidden: false,
+    createElement() {
+      const canvas = { getContext: () => context, style: {}, setAttribute() {}, remove() { this.removed = true; } };
+      canvases.push(canvas);
+      return canvas;
+    },
+  });
+  const media = Object.assign(target(), { matches: still });
+  const stage = Object.assign(target(), {
+    dataset: {}, querySelector: () => null, querySelectorAll: () => [],
+    setAttribute(name) { this.dataset[name.replace('data-', '')] = ''; },
+    removeAttribute(name) { delete this.dataset[name.replace('data-', '')]; },
+  });
+  const host = {
+    append() {},
+    getBoundingClientRect() { reads += 1; return { width: 400, height: 400, left: 0, top: 0 }; },
+  };
+  class Observer {
+    constructor(fn) { this.fn = fn; observers.push(this); }
+    observe() {}
+    disconnect() { this.disconnected = true; }
+  }
+  class Resize extends Observer {
+    constructor(fn) { super(fn); resizeObservers.push(this); }
+  }
+  const replacements = {
+    document: doc, window: { devicePixelRatio: 1, matchMedia: () => media },
+    performance: { now: () => now },
+    requestAnimationFrame(fn) { const id = ++serial; frames.set(id, fn); return id; },
+    cancelAnimationFrame(id) { frames.delete(id); },
+    IntersectionObserver: Observer, ResizeObserver: Resize,
+  };
+  for (const [name, value] of Object.entries(replacements)) {
+    saved.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+    Object.defineProperty(globalThis, name, { configurable: true, writable: true, value });
+  }
+  t.after(() => {
+    globe?.destroy();
+    for (const [name, descriptor] of saved) {
+      if (descriptor) Object.defineProperty(globalThis, name, descriptor); else delete globalThis[name];
+    }
+  });
+  globe = mountGlobe(host, stage, still);
+  return {
+    globe, doc, stage, media, canvases, observers, resizeObservers,
+    get paints() { return paints; }, get reads() { return reads; }, get pending() { return frames.size; }, get frameCalls() { return frameCalls; },
+    advance(ms) {
+      const end = now + ms;
+      while (now < end) {
+        now = Math.min(end, now + 16);
+        const batch = [...frames];
+        frames.clear();
+        for (const [, fn] of batch) { frameCalls += 1; fn(now); }
+      }
+    },
+    intersect(visible) { observers[0].fn([{ isIntersecting: visible }]); },
+  };
+}
+
+test('globe stops after 8 s idle with zero callbacks or layout reads in the following 5 s', (t) => {
+  const b = browser(t);
+  b.advance(8100);
+  const { paints, reads, frameCalls } = b;
+  b.advance(5000);
+  t.diagnostic(`Following 5 s idle: ${b.frameCalls - frameCalls} rAF callbacks, ${b.paints - paints} canvas clears, ${b.reads - reads} layout reads`);
+  assert.equal(b.frameCalls, frameCalls);
+  assert.equal(b.stage.dataset.paused, 'true');
+  assert.equal(b.pending, 0);
+  assert.equal(b.paints, paints);
+  assert.equal(b.reads, reads);
+  b.stage.emit('pointermove');
+  assert.equal(b.pending, 1, 'moving over the globe starts one loop');
+  b.stage.emit('pointermove');
+  assert.equal(b.pending, 1, 'repeat interactions do not multiply loops');
+  b.advance(100);
+  assert.ok(b.paints > paints);
+  assert.equal(b.reads, reads, 'animation and pointer movement never measure layout');
+  b.advance(8100);
+  b.globe.select('okx');
+  assert.equal(b.pending, 1, 'calculator selection also restarts the globe');
+});
+
+test('hidden and offscreen globes cancel animation and do not revive after inactivity', (t) => {
+  const b = browser(t);
+  b.advance(100);
+  b.intersect(false);
+  assert.equal(b.pending, 0);
+  b.intersect(true);
+  assert.equal(b.pending, 1, 'still-active intro resumes when visible');
+  b.doc.hidden = true;
+  b.doc.emit('visibilitychange');
+  assert.equal(b.pending, 0);
+  const { paints } = b;
+  b.advance(9000);
+  b.resizeObservers[0].fn();
+  assert.equal(b.paints, paints, 'hidden resize does not paint');
+  b.doc.hidden = false;
+  b.doc.emit('visibilitychange');
+  assert.equal(b.pending, 0, 'expired intro stays still on tab return');
+  assert.ok(b.paints > paints, 'tab return restores the resized static bitmap');
+  b.stage.emit('focusin');
+  assert.equal(b.pending, 1, 'keyboard interaction restarts animation');
+});
+
+test('reduced motion paints still frames and reacts to preference changes', (t) => {
+  const b = browser(t, { still: true });
+  b.advance(100);
+  assert.equal(b.pending, 0);
+  const { paints } = b;
+  b.stage.emit('pointermove');
+  b.globe.select('okx');
+  assert.equal(b.pending, 0);
+  assert.ok(b.paints > paints, 'a selected partner still gets a static update');
+  b.media.matches = false;
+  b.media.emit('change', { matches: false });
+  b.stage.emit('pointerdown');
+  assert.equal(b.pending, 1);
+  b.media.matches = true;
+  b.media.emit('change', { matches: true });
+  assert.equal(b.pending, 0, 'enabling reduced motion cancels the live loop immediately');
+});
+
+test('destroy cancels every callback and disconnects observers/listeners', (t) => {
+  const b = browser(t);
+  assert.ok(b.pending > 0);
+  b.globe.destroy();
+  assert.equal(b.pending, 0, 'includes first-frame opacity callback');
+  assert.equal(b.stage.listenerCount + b.doc.listenerCount + b.media.listenerCount, 0);
+  assert.ok(b.observers.every((observer) => observer.disconnected));
+  assert.ok(b.canvases[0].removed);
+  const { paints, reads } = b;
+  b.stage.emit('pointermove');
+  b.globe.select('okx');
+  b.observers[0].fn([{ isIntersecting: true }]);
+  b.resizeObservers[0].fn();
+  b.advance(5000);
+  assert.equal(b.pending, 0);
+  assert.equal(b.paints, paints);
+  assert.equal(b.reads, reads);
+});
diff --git a/pilot-01-prototype/tests/home-idle-scheduler.test.mjs b/pilot-01-prototype/tests/home-idle-scheduler.test.mjs
new file mode 100644
index 00000000..0e7e2ac1
--- /dev/null
+++ b/pilot-01-prototype/tests/home-idle-scheduler.test.mjs
@@ -0,0 +1,91 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createVisibilityScheduler } from "../src/components/shared/visibility-scheduler.js";
+import { startJsonPolling } from "../src/components/shared/json-polling.js";
+import { visibilityClock } from "./helpers/visibility-clock.mjs";
+
+test("home polls and clocks share one timer; settled unchanged feeds do not render", async () => {
+  for (const route of ["/", "/zh-hans", "/tr"]) {
+    const clock = visibilityClock();
+    const scheduler = createVisibilityScheduler(clock);
+    let renders = 0, requests = 0, clockTicks = 0;
+    const stops = [6000, 60000, 60000, 60000, 300000, 300000].map(intervalMs => startJsonPolling({
+      request: "/cached-feed", intervalMs, scheduler, documentRef: clock.documentRef,
+      fetchImpl: async () => { requests++; return Response.json({ items: [1], status: "ok" }); },
+      onData: () => { renders++; },
+      setTimer: clock.setTimer, clearTimer: clock.clearTimer, now: clock.now,
+    }));
+    for (const delay of [30000, 30000, 60000, 60000]) stops.push(scheduler.schedule(() => { clockTicks++; }, delay, { repeat: delay }));
+    await clock.advance(0);
+    assert.equal(clock.timers.size, 1, route);
+    const before = clock.callbacks();
+    await clock.advance(10000);
+    assert.equal(clock.callbacks() - before, 1, "one ticker wakeup / 10 s = 0.5 / 5 s");
+    assert.equal(requests, 7);
+    assert.equal(renders, 6, "identical ticker payload does not reach React/DOM delivery");
+    assert.equal(clockTicks, 0);
+    clock.visibility("hidden");
+    assert.equal(clock.timers.size, 0);
+    const hiddenCallbacks = clock.callbacks();
+    await clock.advance(60000);
+    assert.equal(clock.callbacks(), hiddenCallbacks, "zero hidden-page timer callbacks");
+    clock.visibility("visible"); await clock.advance(0);
+    assert.equal(requests, 11, "four overdue feeds refresh once, not once for each missed interval");
+    assert.equal(renders, 6);
+    assert.equal(clockTicks, 4);
+    assert.equal(clock.timers.size, 1);
+    stops.forEach(stop => stop());
+    assert.equal(clock.timers.size, 0);
+    assert.equal(clock.listeners.size, 0);
+    console.log(`${route}: 1 native timer, 0.5 callbacks/5s settled, 0 unchanged deliveries, 0 hidden callbacks`);
+  }
+});
+
+test("an unchanged payload still checks expiry, changed/unavailable data replaces the last snapshot", async () => {
+  const clock = visibilityClock(), scheduler = createVisibilityScheduler(clock);
+  let value = { status: "ok", price: 1 }, success = 0;
+  const received = [];
+  const stop = startJsonPolling({ request: "/feed", intervalMs: 1000, initialData: value,
+    scheduler, documentRef: clock.documentRef, now: clock.now, setTimer: clock.setTimer, clearTimer: clock.clearTimer,
+    fetchImpl: async () => Response.json(value), onData: data => received.push(data), onSuccess: () => { success++; },
+  });
+  await clock.advance(1000);
+  assert.equal(success, 2); assert.equal(received.length, 0);
+  value = { status: "unavailable" }; await clock.advance(1000);
+  assert.deepEqual(received, [{ status: "unavailable" }]);
+  stop();
+});
+
+test("hidden in-flight deadlines expire, ignore late data and retain failure backoff", async () => {
+  const clock = visibilityClock(), scheduler = createVisibilityScheduler(clock);
+  let late, errors = 0, calls = 0;
+  const received = [];
+  const stop = startJsonPolling({ request: "/feed", intervalMs: 1000, timeoutMs: 100,
+    scheduler, documentRef: clock.documentRef, now: clock.now, setTimer: clock.setTimer, clearTimer: clock.clearTimer,
+    fetchImpl: () => { calls++; return new Promise(resolve => { late = resolve; }); },
+    onData: data => received.push(data), onError: () => { errors++; },
+  });
+  await clock.advance(0); clock.visibility("hidden"); await clock.advance(100);
+  assert.equal(errors, 1); assert.equal(clock.timers.size, 0);
+  late(Response.json({ late: true })); await clock.advance(0);
+  assert.deepEqual(received, []);
+  clock.visibility("visible"); await clock.advance(1999); assert.equal(calls, 1);
+  await clock.advance(1); assert.equal(calls, 2);
+  stop(); assert.equal(clock.timers.size, 0); assert.equal(clock.listeners.size, 0);
+});
+
+test("recovery delivers an identical good payload after an error changed visible status", async () => {
+  const clock = visibilityClock(), scheduler = createVisibilityScheduler(clock);
+  const payload = { status: "ok", items: [1] };
+  let failed = false, status = "ok", deliveries = 0;
+  const stop = startJsonPolling({ request: "/feed", intervalMs: 1000, initialData: payload,
+    scheduler, documentRef: clock.documentRef, now: clock.now, setTimer: clock.setTimer, clearTimer: clock.clearTimer,
+    fetchImpl: async () => failed ? new Response("offline", { status: 503 }) : Response.json(payload),
+    onData: () => { status = "ok"; deliveries++; }, onError: () => { status = "unavailable"; },
+  });
+  await clock.advance(0); assert.equal(deliveries, 0);
+  failed = true; await clock.advance(1000); assert.equal(status, "unavailable");
+  failed = false; await clock.advance(2000);
+  assert.equal(status, "ok"); assert.equal(deliveries, 1);
+  stop();
+});
