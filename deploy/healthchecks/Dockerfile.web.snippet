# Insert into the reviewed web image only when server.mjs is the entrypoint.
# Existing deployment uses docker run, not this Dockerfile; no deployment edit.
HEALTHCHECK --interval=30s --timeout=8s --start-period=5m --retries=3 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health/web-ready',{signal:AbortSignal.timeout(5000),redirect:'manual'}).then(r=>process.exit(r.status===200?0:1)).catch(()=>process.exit(1))"
