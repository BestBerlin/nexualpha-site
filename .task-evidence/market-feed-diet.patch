@@ -0,0 +1,108 @@
+#!/usr/bin/env node
+// Offline response-body measurements, not a browser network trace. Run once per built revision.
+import assert from 'node:assert/strict';
+import { readFile, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { pathToFileURL, fileURLToPath } from 'node:url';
+import { gzipSync } from 'node:zlib';
+import { createNewsSsrRenderer } from '../server/news-ssr.mjs';
+import { createMarketEventsReader } from '../server/market-events-feed.mjs';
+import { detectArticleAssets } from '../src/components/v3/news/article-market-context.js';
+import { compactMarketEvents } from '../src/data/market-data-pages.js';
+import { createSsrHarness, hydrateInJsdom, hydrationErrors, prerenderState } from '../tests/helpers/ssr-hydration-harness.mjs';
+const phase = process.argv[2];
+assert.ok(['before', 'after'].includes(phase), 'usage: node scripts/measure-market-feed-diet.mjs before|after');
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const fixture = 'tests/fixtures/market-data/market-events.live-v2-2026-10-13.json';
+const feedText = await readFile(path.join(root, fixture), 'utf8');
+const feed = JSON.parse(feedText);
+const sizes = text => ({ rawBytes: Buffer.byteLength(text), gzipBytes: gzipSync(text).length });
+const sha256 = text => createHash('sha256').update(text).digest('hex');
+const { default: worker } = await import(pathToFileURL(path.join(root, 'dist/server/index.js')));
+const render = createNewsSsrRenderer(path.join(root, 'dist'));
+const market = createMarketEventsReader({ file: path.join(root, fixture) });
+const localAssets = { fetch: async request => {
+  const pathname = new URL(request.url).pathname;
+  if (pathname === '/intel/market-events.json') return new Response(feedText, { headers: { 'content-type': 'application/json' } });
+  try {
+    const body = await readFile(path.join(root, 'dist/client', pathname));
+    return new Response(body, { headers: { 'content-type': pathname.endsWith('.html') ? 'text/html' : pathname.endsWith('.json') ? 'application/json' : 'text/plain' } });
+  } catch { return new Response('', { status: 404 }); }
+} };
+const env = { ASSETS: localAssets, NEWS_SSR_RENDER: render, MARKET_EVENTS_READ: market.read,
+  TICKER_READ: async () => null, MOVERS_READ: async () => null, FX_SNAPSHOT_READ: async () => null,
+};
+const fetchLocal = async href => {
+  const request = new Request(new URL(href, 'https://nexualpha.com'), { headers: { accept: href.startsWith('/api/') ? 'application/json' : 'text/html' } });
+  if (new URL(request.url).pathname === '/intel/market-events.json') return localAssets.fetch(request);
+  return worker.fetch(request, env);
+};
+const articles = JSON.parse(await readFile(path.join(root, 'public/content/news-feed.json'))).articles;
+const sample = articles.find(article => typeof article.content?.en === 'string' && typeof article.content?.['zh-Hans'] === 'string'
+  && detectArticleAssets({ title: `${article.title?.en}\n${article.title?.['zh-Hans']}`, summary: article.summary?.en, body: article.content.en }).length);
+assert.ok(sample, 'need a checked-in English + Chinese article mentioning supported assets');
+const coins = JSON.parse(await readFile(path.join(root, 'public/intel/coins.json')));
+const coin = (coins.coins || coins.rows || []).find(row => String(row.symbol).toUpperCase() === 'BTC');
+const coinPath = '/coins/' + (coin?.slug || 'bitcoin');
+const pages = [`/news/${sample.slug}`, `/zh-hans/news/${sample.slug}`, '/exchanges/okx', '/compare/binance-vs-okx', coinPath];
+const harness = await createSsrHarness();
+const measurements = [];
+try {
+  for (const pathname of pages) {
+    const response = await fetchLocal(pathname), html = await response.text();
+    assert.equal(response.status, 200, pathname);
+    const requests = [];
+    const hydrated = await hydrateInJsdom(harness.vite, html, `https://nexualpha.com${pathname}`, {
+      timeoutMs: 700, settleMs: 20,
+      fetchImpl: async input => {
+        const href = String(input?.url || input);
+        const response = await fetchLocal(href), body = await response.text();
+        requests.push({ path: href, status: response.status, ...sizes(body) });
+        return new Response(body, { status: response.status, headers: response.headers });
+      },
+      inspect: window => ({ rail: window.document.querySelector('[data-market-context]')?.outerHTML || null }),
+    });
+    const marketRequests = requests.filter(row => /market-events/.test(row.path));
+    assert.deepEqual(hydrationErrors(hydrated.errors), [], pathname);
+    if (phase === 'after' && pathname.includes('/news/')) {
+      assert.ok(prerenderState(html)?.marketEvents, 'built article must carry its SSR market seed');
+      assert.equal(marketRequests.length, 0, 'hydration must not insert the market rail from a client fetch');
+    }
+    measurements.push({ path: pathname, status: response.status, html: { ...sizes(html), sha256: sha256(html) },
+      marketRequests, allObservedJsonRequests: requests,
+      initialHtmlPlusMarketJson: {
+        rawBytes: sizes(html).rawBytes + marketRequests.reduce((sum, row) => sum + row.rawBytes, 0),
+        gzipBytes: sizes(html).gzipBytes + marketRequests.reduce((sum, row) => sum + row.gzipBytes, 0),
+      },
+      hydrationErrors: hydrationErrors(hydrated.errors), hasRailAfterHydration: Boolean(hydrated.inspected?.rail),
+    });
+  }
+} finally { await harness.close(); }
+const assetResponses = [];
+for (const query of ['symbol=BTC', 'symbols=BTC,ETH']) {
+  const response = await fetchLocal(`/api/market-events/asset?${query}`), body = await response.text();
+  assetResponses.push({ query, status: response.status, ...sizes(body), body: response.status === 200 ? JSON.parse(body) : undefined });
+}
+const summaryResponse = await fetchLocal('/api/market-events/summary'), summaryText = await summaryResponse.text();
+const summary = JSON.parse(summaryText);
+const dataPages = {};
+for (const pathname of ['/liquidations', '/liquidations/heatmap', '/funding-rates']) {
+  const fullHtml = await render(pathname, { marketEvents: feed });
+  const summaryHtml = await render(pathname, { marketEvents: summary });
+  const trimmed = pathname === '/funding-rates' ? { generatedAt: feed.generatedAt, funding: feed.funding }
+    : { generatedAt: feed.generatedAt, liquidations: feed.liquidations, history: feed.history };
+  const trimmedHtml = await render(pathname, { marketEvents: trimmed });
+  dataPages[pathname] = { fullVsSummaryRenderedHtmlByteIdentical: fullHtml === summaryHtml,
+    fullHtmlSha256: sha256(fullHtml), summaryHtmlSha256: sha256(summaryHtml),
+    trimmedCandidate: { ...sizes(JSON.stringify(trimmed)), renderedHtmlByteIdentical: fullHtml === trimmedHtml, htmlSha256: sha256(trimmedHtml) },
+    currentSsrProjection: sizes(JSON.stringify(compactMarketEvents(feed, { timeline: pathname !== '/funding-rates', firstScreen: true }))),
+  };
+}
+const output = { phase, node: process.version, fixture, fixtureGeneratedAt: feed.generatedAt, fixtureSha256: sha256(feedText),
+  methodology: 'In-process built Worker + bundled runtime SSR; jsdom hydration observes local JSON requests for 700 ms. Body bytes only; gzipSync estimate excludes headers, TLS, caches, JS, CSS and images. Historical checked-in feed, not the reported 2.4 MB production feed. No external requests.',
+  fullFeed: sizes(feedText), summary: { status: summaryResponse.status, ...sizes(summaryText) }, assetResponses, pages: measurements, dataPages,
+};
+await writeFile(path.join(root, 'docs/evidence/market-feed-diet', `${phase}.json`), JSON.stringify(output, null, 2) + '\n');
+console.log(JSON.stringify({ phase, fullFeed: output.fullFeed, summary: output.summary, assetResponses: assetResponses.map(({ body, ...row }) => row),
+  pages: measurements.map(({ path, initialHtmlPlusMarketJson, hydrationErrors }) => ({ path, ...initialHtmlPlusMarketJson, hydrationErrors: hydrationErrors.length })) }, null, 2));
diff --git a/pilot-01-prototype/src/components/v3/news/article-market-context-fetch.js b/pilot-01-prototype/src/components/v3/news/article-market-context-fetch.js
new file mode 100644
index 00000000..d883bc47
--- /dev/null
+++ b/pilot-01-prototype/src/components/v3/news/article-market-context-fetch.js
@@ -0,0 +1,22 @@
+import { MARKET_ASSET_PATH } from '../../../data/market-events-assets.js';
+
+// A multi-asset API request fails closed if any symbol is missing. Keep refreshing available rail rows
+// during partial collector coverage by retrying each detected symbol only after that explicit 404.
+export async function fetchArticleMarketContext(request, init, symbols, fetchImpl = fetch) {
+  const response = await fetchImpl(request, init);
+  if (response.status !== 404 || symbols.length < 2) return response;
+  const parts = await Promise.all(symbols.map(async symbol => {
+    const part = await fetchImpl(`${MARKET_ASSET_PATH}?symbol=${encodeURIComponent(symbol)}`, init);
+    if (part.status === 404) return null;
+    if (!part.ok) throw new Error(`market asset HTTP ${part.status}`);
+    return part.json();
+  }));
+  const frames = parts.filter(Boolean);
+  if (!frames.length) return response;
+  // Never combine figures carrying different collector clocks. Keep the previous frame and retry later.
+  const generatedAt = frames[0].generatedAt;
+  if (!generatedAt || frames.some(frame => frame.generatedAt !== generatedAt || !Array.isArray(frame.rows))) {
+    throw new Error('market asset snapshots disagree');
+  }
+  return Response.json({ generatedAt, stale: frames.some(frame => frame.stale === true), rows: frames.flatMap(frame => frame.rows) });
+}
diff --git a/pilot-01-prototype/src/data/market-events-assets.js b/pilot-01-prototype/src/data/market-events-assets.js
new file mode 100644
index 00000000..5ce9b1b4
--- /dev/null
+++ b/pilot-01-prototype/src/data/market-events-assets.js
@@ -0,0 +1,101 @@
+import { localizedNewsTitle, localizedNewsSummary, localizedValue, resolveNewsContentLocale } from "./news-feed-client.js";
+import { neutralArticleMarkdown } from "./neutral-article.js";
+import { stripArticleEmbedDirectives } from "./article-embeds.js";
+import { serpCtrNewsOverride } from "./serp-ctr-news-overrides.js";
+
+// Small, shared projection for article rails and /api/market-events/asset.
+// Keep this out of the home entry; the collector remains the only source of figures.
+export const MARKET_ASSET_PATH = "/api/market-events/asset";
+
+export const MARKET_CONTEXT_ASSETS = Object.freeze([
+  { symbol: "BTC", pattern: /\bBTC\b|\bbitcoin\b|比特币|比特幣|ビットコイン|비트코인|биткоин|بيتكوين/i },
+  { symbol: "ETH", pattern: /\bETH\b|\bethereum\b|\bether\b|以太坊|イーサリアム|이더리움|эфириум|إيثريوم/i },
+  { symbol: "SOL", pattern: /\bSOL\b|\bsolana\b|ソラナ|솔라나|солана|سولانا/i },
+]);
+
+const countMatches = (text, pattern) => (String(text || "").match(new RegExp(pattern.source, "gi")) || []).length;
+
+/** Up to `limit` assets: those named in the title or summary first, then those mentioned at least twice in the body. */
+export function detectArticleAssets({ title = "", summary = "", body = "" } = {}, limit = 2) {
+  const head = `${title}\n${summary}`;
+  const scored = MARKET_CONTEXT_ASSETS.map(({ symbol, pattern }, order) => {
+    const inHead = countMatches(head, pattern);
+    const inBody = countMatches(body, pattern);
+    return { symbol, order, inHead, inBody };
+  }).filter((a) => a.inHead > 0 || a.inBody >= 2);
+  scored.sort((a, b) => (b.inHead > 0) - (a.inHead > 0) || b.inBody - a.inBody || a.order - b.order);
+  return scored.slice(0, limit).map((a) => a.symbol);
+}
+
+/** Use the exact same article text on the server and client when selecting assets. */
+export function articleMarketAssets(article, locale) {
+  const contentLocale = resolveNewsContentLocale(locale, article);
+  const override = contentLocale === locale ? serpCtrNewsOverride(article.slug, locale) : null;
+  const title = override?.h1 || localizedNewsTitle(article, locale);
+  const summary = neutralArticleMarkdown(localizedNewsSummary(article, locale), locale);
+  const content = neutralArticleMarkdown(localizedValue(article.content, contentLocale), locale);
+  return detectArticleAssets({
+    title: `${title}\n${localizedNewsTitle(article, "en")}`,
+    summary: `${summary}\n${localizedNewsSummary(article, "en")}`,
+    body: stripArticleEmbedDirectives(content),
+  });
+}
+
+const num = (v) => { const n = typeof v === "number" ? v : Number.parseFloat(v); return Number.isFinite(n) ? n : null; };
+const baseOf = (symbol) => String(symbol || "").replace(/^[A-Z]+:/i, "").replace(/(USDT|USDC|USD|BUSD)$/i, "").toUpperCase();
+
+/** One row per detected asset with the figures the feed actually has; null when the feed has none of them. */
+export function marketAssetSnapshot(feed, assets) {
+  if (!feed || typeof feed !== "object" || !Array.isArray(assets) || !assets.length) return null;
+  const generatedAt = Number.isFinite(Date.parse(feed.generatedAt)) ? new Date(Date.parse(feed.generatedAt)).toISOString() : null;
+  if (!generatedAt) return null;
+  // SSR and the asset API already carry the exact rendered rows. Never re-derive numbers on hydration.
+  if (Array.isArray(feed.rows)) {
+    const rows = assets.map(symbol => feed.rows.find(row => row.symbol === symbol)).filter(Boolean);
+    return rows.length ? { generatedAt, rows } : null;
+  }
+  const majors = Array.isArray(feed.market?.majors) ? feed.market.majors : [];
+  const fundingRows = Array.isArray(feed.funding?.rows) ? feed.funding.rows : [];
+  const top24 = Array.isArray(feed.liquidations?.h24?.topSymbols) ? feed.liquidations.h24.topSymbols : [];
+  const rows = assets.map((symbol) => {
+    const major = majors.find((m) => baseOf(m?.symbol) === symbol);
+    const funding = fundingRows.find((r) => baseOf(r?.symbol) === symbol);
+    const liqHits = top24.filter((t) => baseOf(t?.symbol) === symbol && num(t?.usd) > 0);
+    const row = {
+      symbol,
+      price: num(major?.price),
+      change24hPct: num(major?.change24hPct),
+      fundingBinance: num(funding?.binanceRate),
+      fundingOkx: num(funding?.okxRate),
+      liquidations24hUsd: liqHits.length ? liqHits.reduce((sum, t) => sum + num(t.usd), 0) : null,
+    };
+    const has = row.price != null || row.fundingBinance != null || row.fundingOkx != null || row.liquidations24hUsd != null;
+    return has ? row : null;
+  }).filter(Boolean);
+  return rows.length ? { generatedAt, rows } : null;
+}
+
+
+/** Reject ambiguous, empty or oversized requests before reading the collector. */
+export function parseMarketAssetSymbols(params) {
+  const single = params.getAll("symbol"), multiple = params.getAll("symbols");
+  if (single.length + multiple.length !== 1) return null;
+  const values = (single[0] ?? multiple[0]).split(",").map(value => value.trim().toUpperCase());
+  if (!values.length || values.length > 5 || (single.length && values.length !== 1)
+    || values.some(value => !/^[A-Z0-9]{1,20}$/.test(value))) return null;
+  return [...new Set(values)];
+}
+
+export async function marketAssetResponse(url, readFeed) {
+  const symbols = parseMarketAssetSymbols(url.searchParams);
+  const error = (status, code) => Response.json({ error: code }, { status, headers: { "cache-control": "no-store" } });
+  if (!symbols) return error(400, "INVALID_SYMBOLS");
+  let feed;
+  try { feed = await readFeed(); } catch { /* cold outage fails closed */ }
+  if (!feed || !Number.isFinite(Date.parse(feed.generatedAt))) return error(503, "MARKET_FEED_UNAVAILABLE");
+  const snapshot = marketAssetSnapshot(feed, symbols);
+  if (!snapshot || snapshot.rows.length !== symbols.length) return error(404, "UNKNOWN_SYMBOL");
+  return Response.json({ ...snapshot, stale: feed.stale === true }, {
+    headers: { "cache-control": "public, max-age=30" },
+  });
+}
diff --git a/pilot-01-prototype/tests/market-events-assets-ssr.test.mjs b/pilot-01-prototype/tests/market-events-assets-ssr.test.mjs
